# Generate EACH secret separately with: openssl rand -hex 32
# Replace all placeholders. Never commit .env or real student data.
POSTGRES_USER=klmce_migrator
POSTGRES_PASSWORD=REPLACE_DATABASE_OWNER_PASSWORD
POSTGRES_DB=klmce_erp
DATABASE_ADMIN_URL=postgresql://klmce_migrator:REPLACE_DATABASE_OWNER_PASSWORD@localhost:5432/klmce_erp
ERP_DB_PASSWORD=REPLACE_RESTRICTED_RUNTIME_PASSWORD
DATABASE_URL=postgresql://erp_runtime:REPLACE_RESTRICTED_RUNTIME_PASSWORD@postgres:5432/klmce_erp
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@redis:6379/0
SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
ATTENDANCE_AES_KEY=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHARACTERS
ATTENDANCE_HMAC_KEY=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHARACTERS
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHARACTERS
WEBHOOK_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHARACTERS
# Razorpay sandbox only. Use a dedicated staging database with synthetic users.
# Never paste credentials into chat or commit populated environment files.
RAZORPAY_ENABLED=false
RAZORPAY_TENANT_ID=
RAZORPAY_ACCOUNT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Direct PostgreSQL default; set 0 for transaction poolers without prepared statements.
DB_STATEMENT_CACHE_SIZE=100
FRONTEND_URL=https://erp.example.edu
ERP_API_URL=http://backend:8000/api/v1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_FROM_CLERK
CLERK_SECRET_KEY=REPLACE_FROM_CLERK
CLERK_ISSUER=https://REPLACE_YOUR_INSTANCE.clerk.accounts.dev
# Set only if your actual Clerk session-token configuration includes this audience.
CLERK_AUDIENCE=
DB_MIN_CONNS=2
DB_MAX_CONNS=10
REDIS_MAX_CONNS=100
