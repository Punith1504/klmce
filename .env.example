# ==========================================
# Database Configuration
# ==========================================
POSTGRES_USER=klmce_superuser
POSTGRES_PASSWORD=replace_with_secure_postgres_password_in_prod
POSTGRES_DB=klmce_erp
DATABASE_URL=postgresql+asyncpg://klmce_superuser:replace_with_secure_postgres_password_in_prod@postgres:5432/klmce_erp

# ==========================================
# Redis Configuration
# ==========================================
REDIS_PASSWORD=replace_with_secure_redis_password_in_prod
REDIS_URL=redis://:replace_with_secure_redis_password_in_prod@redis:6379/0

# ==========================================
# Cryptographic Keys & Secrets (Must be exactly 32 bytes/256-bit hex strings)
# ==========================================
# Execute `openssl rand -hex 32` to generate secure values
SECRET_KEY=replace_with_a_32_byte_hex_string_for_jwt_signing
ATTENDANCE_AES_KEY=replace_with_a_32_byte_hex_string_for_qr_encryption
WEBHOOK_SECRET=replace_with_a_32_byte_hex_string_for_hmac_validation

# ==========================================
# Frontend / Backend Communication
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
